# Groq is used when set; OpenAI is the fallback on 429, 5xx or network errors.
GROQ_API_KEY=
GROQ_MODEL=
OPENAI_API_KEY=
# Optional. Raises GitHub's limit from 60 to 5000 requests per hour.
GITHUB_TOKEN=
OPENAI_MODEL=gpt-5.4-mini
RATE_LIMIT_NOTES=4
RATE_LIMIT_REFS=20
RATE_LIMIT_WINDOW_MS=3600000
MAX_COMMITS=150
# Upstash Redis for shared rate limits. Without these the limiter uses process memory.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
